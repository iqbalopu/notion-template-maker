{
  "name": "notion-template-maker",
  "version": "0.1.0",
  "description": "Automated Notion template maker - Create and manage Notion templates programmatically",
  "main": "dist/cli/index.js",
  "bin": {
    "notion-template": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "watch": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "notion",
    "template",
    "automation",
    "cli",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.4",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

